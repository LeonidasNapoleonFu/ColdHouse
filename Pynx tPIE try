def epie_warm_start(p,nb_cycle=2,alpha=0.8,beta=0.2):
    obj=np.squeeze(p.get_obj()).astype(np.complex64).copy()
    probe=np.squeeze(p.get_probe()).astype(np.complex64).copy()
    iobs=p.get_iobs(shift=True)
    posx=np.asarray(p.data.posx)
    posy=np.asarray(p.data.posy)
    pixel_size=p.data.pixel_size_object()[0]
    nyo,nxo=obj.shape
    nyp,nxp=probe.shape
    cx=nxo//2
    cy=nyo//2
    rng=np.random.default_rng(0)
    for cycle in range(nb_cycle):
        err=0.0
        nused=0
        for j in rng.permutation(len(posx)):
            dx=int(np.rint(posx[j]/pixel_size))
            dy=int(np.rint(posy[j]/pixel_size))
            x0=cx+dx-nxp//2
            y0=cy+dy-nyp//2
            patch=obj[y0:y0+nyp,x0:x0+nxp]
            if patch.shape!=probe.shape:
                continue
            exit_wave=patch*probe
            psi=np.fft.fftshift(np.fft.fft2(np.fft.ifftshift(exit_wave),norm='ortho'))
            calc_amp=np.abs(psi)
            obs_j=iobs[j]
            mask=np.ma.getmaskarray(obs_j)
            obs=np.ma.filled(obs_j,0.0)
            valid=~mask
            psi_new=psi.copy()
            psi_new[valid]=np.sqrt(np.maximum(obs[valid],0))*psi[valid]/np.maximum(calc_amp[valid],1e-12)
            exit_new=np.fft.fftshift(np.fft.ifft2(np.fft.ifftshift(psi_new),norm='ortho'))
            delta=exit_new-exit_wave
            obj_old=patch.copy()
            probe_old=probe.copy()
            patch+=alpha*np.conj(probe_old)/(np.max(np.abs(probe_old)**2)+1e-12)*delta
            probe+=beta*np.conj(obj_old)/(np.max(np.abs(obj_old)**2)+1e-12)*delta
            obj[y0:y0+nyp,x0:x0+nxp]=patch
            err+=np.mean((calc_amp[valid]-np.sqrt(np.maximum(obs[valid],0)))**2)
            nused+=1
        print(f"ePIE {cycle+1}/{nb_cycle} error={err/max(nused,1):.6e}")
    return obj,probe

def ring_field(P,cx,cy,r,n=None):
    if n is None:
        n=max(64,int(np.ceil(4*np.pi*r)))
    t=np.linspace(0,2*np.pi,n,endpoint=False)
    x=cx+r*np.cos(t)
    y=cy+r*np.sin(t)
    re=map_coordinates(P.real,[y,x],order=1,mode='nearest')
    im=map_coordinates(P.imag,[y,x],order=1,mode='nearest')
    return re+1j*im

def winding(P,cx,cy,r):
    z=ring_field(P,cx,cy,r)
    dphi=np.angle(np.roll(z,-1)*np.conj(z))
    q=dphi.sum()/(2*np.pi)
    conf=np.percentile(np.abs(z),5)/(np.max(np.abs(P))+1e-30)
    return q,conf,np.max(np.abs(dphi))

def topology_measure(P,cx,cy,radii,q0,tol=0.15,min_valid=3):
    qs=[]
    for r in radii:
        q,conf,dmax=winding(P,cx,cy,r)
        if conf>0.05 and dmax<0.8*np.pi:
            qs.append(q)
    if len(qs)<min_valid:
        return "invalid",np.asarray(qs)
    qs=np.asarray(qs)
    if np.mean(np.abs(qs-q0)<tol)>=0.75:
        return "preserved",qs
    return "changed",qs

def topology_guard(P0,P1,q0,cx,cy,radii,nscan=20,nrefine=12,safety=0.98):
    status,qs=topology_measure(P1,cx,cy,radii,q0)
    if status=="preserved":
        return P1,1.0,status,qs
    c=np.vdot(P0,P1)
    if abs(c)>0:
        P1=P1*np.exp(-1j*np.angle(c))
    dP=P1-P0
    status0,qs0=topology_measure(P0,cx,cy,radii,q0)
    if status0!="preserved":
        return P0,0.0,status0,qs0
    lo=0.0
    hi=None
    for eta in np.linspace(1/nscan,1,nscan):
        Pt=P0+eta*dP
        s,_=topology_measure(Pt,cx,cy,radii,q0)
        if s=="preserved":
            lo=eta
        else:
            hi=eta
            break
    if hi is None:
        s,qs=topology_measure(P1,cx,cy,radii,q0)
        return P1,1.0,s,qs
    for _ in range(nrefine):
        mid=(lo+hi)/2
        Pt=P0+mid*dP
        s,_=topology_measure(Pt,cx,cy,radii,q0)
        if s=="preserved":
            lo=mid
        else:
            hi=mid
    eta=safety*lo
    Pg=P0+eta*dP
    s,qs=topology_measure(Pg,cx,cy,radii,q0)
    return Pg,eta,s,qs

