            else:
                status,qs=topology_measure(P1,cx,cy,TOPO_RADII,TOPO_Q0)
                eta=1.0
                if status=="preserved":
                    preserved_streak+=1
                    if preserved_streak>=TOPO_LOCK_STREAK:
                        tpie_active=True
                        print(f"tPIE LOCKED at TDM cycle {tdm_global_cycle+1}")
                else:
                    preserved_streak=0
            qmean=np.mean(qs) if len(qs)>0 else np.nan
            tpie_log.append([tdm_global_cycle+1,eta,status,qmean,len(qs),int(tpie_active)])
            tdm_global_cycle+=1
            if (ic+1)%10==0 or eta<0.999:
                print(f"TDM {ic+1:03d}/{cycles} eta={eta:.5f} Q={np.round(qs,3)} {status} lock={tpie_active}")
        llk=p.get_llk('poisson')
    elif algo=="DM":
        p=DM(update_object=update_obj,update_probe=update_probe,update_background=False,nb_cycle=cycles,calc_llk=20,show_obj_probe=False,obj_smooth_sigma=0,obj_inertia=0.05,probe_smooth_sigma=0.2,probe_inertia=0.02,update_pos=False,zero_phase_ramp=True,alpha=0.02)*p
