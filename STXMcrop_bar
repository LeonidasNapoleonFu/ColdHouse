import numpy as np
import tifffile
import matplotlib.pyplot as plt
from pathlib import Path

# ==================== 输入 ====================
file_path = r"C:\Users\Public\FuPeiran\Tool4Beamline-main\20251206\SF20251206235005intp.tiff"

pixel_size_nm = 10.0       # STXM: 10 nm/pixel
crop_size_um = 2.0         # 最终显示区域宽度，例如 2 μm × 2 μm
bar_nm = 200.0             # 标尺长度

# 如果就是裁图像中心，保持 None
# 如果想手动指定中心，就填写像素坐标，例如 cx=248, cy=263
cx = 200
cy = 230

# ==================== 读取图像 ====================
img = tifffile.imread(file_path)

if img.ndim != 2:
    raise ValueError(f"当前 TIFF 不是二维图像，shape = {img.shape}")

ny, nx = img.shape

if cx is None:
    cx = nx // 2

if cy is None:
    cy = ny // 2

# ==================== 按物理尺寸计算裁剪范围 ====================
crop_size_nm = crop_size_um * 1000.0
crop_size_px = int(round(crop_size_nm / pixel_size_nm))

# 保证偶数，方便以中心对称裁剪
if crop_size_px % 2 != 0:
    crop_size_px += 1

half = crop_size_px // 2

x1 = cx - half
x2 = cx + half
y1 = cy - half
y2 = cy + half

if x1 < 0 or y1 < 0 or x2 > nx or y2 > ny:
    raise ValueError(
        f"裁剪区域超出图像范围。\n"
        f"原图大小: {nx} × {ny} pixels\n"
        f"中心: ({cx}, {cy})\n"
        f"crop: x={x1}:{x2}, y={y1}:{y2}"
    )

crop = img[y1:y2, x1:x2]

print("原图尺寸:", img.shape)
print("裁剪中心:", (cx, cy))
print("裁剪范围:", f"x={x1}:{x2}, y={y1}:{y2}")
print("裁剪尺寸:", crop.shape)
print(
    f"实际物理尺寸: "
    f"{crop.shape[1] * pixel_size_nm / 1000:.3f} μm × "
    f"{crop.shape[0] * pixel_size_nm / 1000:.3f} μm"
)

# ==================== 标尺 ====================
bar_px = bar_nm / pixel_size_nm

# 标尺位置：左下角向内
margin_x = 0.08 * crop.shape[1]
margin_y = 0.08 * crop.shape[0]

x0 = margin_x
y0 = margin_y

# ==================== 绘图 ====================
fig, ax = plt.subplots(figsize=(6, 6))

ax.imshow(
    crop,
    cmap="gray",
    origin="lower",
    interpolation="nearest"
)

ax.plot(
    [x0, x0 + bar_px],
    [y0, y0],
    color="white",
    linewidth=5,
    solid_capstyle="butt"
)

ax.text(
    x0 + bar_px / 2,
    y0 + 0.04 * crop.shape[0],
    f"{bar_nm:.0f} nm",
    color="white",
    fontsize=18,
    ha="center",
    va="bottom"
)

ax.set_xlim(-0.5, crop.shape[1] - 0.5)
ax.set_ylim(-0.5, crop.shape[0] - 0.5)
ax.axis("off")

plt.tight_layout(pad=0)

out_path = Path(file_path).with_name(
    Path(file_path).stem + "_crop_scalebar.png"
)

plt.savefig(
    out_path,
    dpi=600,
    bbox_inches="tight",
    pad_inches=0
)

plt.show()

print("保存至:", out_path)
