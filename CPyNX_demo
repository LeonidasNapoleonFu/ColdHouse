    # ------------------------------------------------------------ CXI 打包 --
    def run_pack(self):
        if self.state.running:
            messagebox.showwarning("忙", "已有任务在运行。")
            return
        try:
            bg, pty, pos, out = map(lambda s: Path(s.strip()), [self.bg_var.get(), self.pty_var.get(), self.pos_var.get(), self.out_var.get()])
            for path, name in ((bg, "本底"), (pty, "衍射"), (pos, "位置")):
                if not path.exists():
                    raise ValueError(f"{name}文件不存在：\n{path}")
            cfg = PackConfig(
                pixel_size_m=float(self.pack_entries["pixel"].get()),
                energy_ev=float(self.pack_entries["energy"].get()),
                detector_distance_m=float(self.pack_entries["distance"].get()),
                frames_per_position=int(self.pack_entries["nframe"].get()),
            )
            x_col, y_col, skiprows = int(self.x_col.get()), int(self.y_col.get()), int(self.skiprows.get())
            if cfg.frames_per_position <= 0: raise ValueError("每位置帧数必须 > 0")
        except Exception as e:
            messagebox.showerror("参数错误", str(e))
            return

        self.set_running(True)
        self.log("=" * 70)
        self.log("开始打包 CXI")
        self.log(f"BG   : {bg}")
        self.log(f"PTY  : {pty}")
        self.log(f"POS  : {pos}")
        self.log(f"OUT  : {out}")

        def worker():
            try:
                self.pack_cxi(bg, pty, pos, out, cfg, x_col, y_col, skiprows)
                self.log_queue.put(("done_pack", str(out)))
            except Exception:
                self.log_queue.put(("line", traceback.format_exc()))
                self.log_queue.put(("failed", "CXI 打包失败"))
        threading.Thread(target=worker, daemon=True).start()

    @staticmethod
    def pack_cxi(bg_file, pty_file, pos_file, out_file, cfg, x_col, y_col, skiprows):
        wavelength = (1239.841984 / cfg.energy_ev) * 1e-9

        bg_stack = tifffile.imread(str(bg_file)).astype(np.float32)
        background = bg_stack.mean(axis=0) if bg_stack.ndim >= 3 else bg_stack

        pty_stack = tifffile.imread(str(pty_file)).astype(np.float32)
        if pty_stack.ndim == 2:
            pty_stack = pty_stack[None]
        if pty_stack.ndim != 3:
            raise ValueError(f"衍射 TIFF 需要是 [frame,y,x]，当前 {pty_stack.shape}")
        if pty_stack.shape[1:] != background.shape:
            raise ValueError(f"本底和衍射尺寸不一致：{background.shape} vs {pty_stack.shape[1:]}")

        pos_data = np.loadtxt(str(pos_file), skiprows=skiprows)
        if pos_data.ndim == 1:
            pos_data = pos_data[None]
        if max(x_col, y_col) >= pos_data.shape[1]:
            raise ValueError(f"位置列超界：位置文件只有 {pos_data.shape[1]} 列")

        npos, nframe, npp = len(pos_data), pty_stack.shape[0], cfg.frames_per_position
        if nframe != npos * npp:
            raise ValueError(
                f"帧数/位置数不匹配：frames={nframe}, positions={npos}, frames_per_position={npp}"
            )

        iobs = pty_stack - background[None]
        np.maximum(iobs, 0, out=iobs)
        if npp > 1:
            iobs = iobs.reshape(npos, npp, *iobs.shape[1:]).mean(axis=1)

        # 当前组内数据坐标约定
        x_cxi = -(pos_data[:, x_col] / 1e6)
        y_cxi = -(pos_data[:, y_col] / 1e6)

        out_file.parent.mkdir(parents=True, exist_ok=True)
        save_ptycho_data_cxi(
            file_name=str(out_file), iobs=iobs,
            pixel_size=cfg.pixel_size_m, wavelength=wavelength,
            detector_distance=cfg.detector_distance_m,
            x=x_cxi, y=y_cxi,
        )

    # -------------------------------------------------------------- 重建 --
    def load_template(self, _=None):
        text = self.templates.get(self.template_var.get(), "")
        self.spell.delete("1.0", tk.END)
        self.spell.insert("1.0", text)

    def build_command(self) -> List[str]:
        cxi = Path(self.recon_cxi.get().strip())
        if not cxi.exists():
            raise ValueError(f"请选择有效 CXI：\n{cxi}")
        if not PYNX_CMD.exists():
            raise ValueError(f"未找到 PyNX CLI：\n{PYNX_CMD}")

        spell = self.spell.get("1.0", tk.END).strip()
        if not spell:
            raise ValueError("重建参数为空")

        args = shlex.split(spell, posix=False)
        args = [a[1:-1] if len(a) >= 2 and a[0] == a[-1] == '"' else a for a in args]
        if not any(a.startswith("--cxifile") or a.startswith("--data") for a in args):
            args.insert(0, f"--cxifile={cxi}")

        prefix = self.save_prefix.get().strip()
        if prefix and not any(a.startswith("--save_prefix") for a in args):
            args.append(f"--save_prefix={prefix}")
        if "--saveplot" not in args:
            args.append("--saveplot")

        self.state.last_cxi = cxi
        self.state.last_save_prefix = Path(prefix) if prefix else None
        return [str(PYNX_CMD), *args]

    def run_recon(self):
        try:
            cmd = self.build_command()
        except Exception as e:
            messagebox.showerror("无法运行", str(e))
            return
        self.start_process(cmd)

    def copy_command(self):
        try:
            cmd = self.build_command()
        except Exception as e:
            messagebox.showerror("无法生成", str(e))
            return
        text = subprocess.list2cmdline(cmd)
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        messagebox.showinfo("已复制", "完整命令已复制。")

    # ---------------------------------------------------------- 自定义算法 --
    def add_algo(self, name):
        try:
            n = int(self.iter_var.get())
            if n <= 0: raise ValueError
        except ValueError:
            messagebox.showerror("错误", "迭代次数必须是正整数")
            return
        self.custom_algos.insert(0, f"{name}**{n}")
        self.refresh_custom()

    def refresh_custom(self):
        txt = self.custom_text.get("1.0", tk.END).strip()
        import re
        rest = re.sub(r'--algorithm="[^"]*"\s*', '', txt).strip()
        alg = f'--algorithm="{",".join(self.custom_algos)}"' if self.custom_algos else ''
        out = (alg + " " + rest).strip()
        self.custom_text.delete("1.0", tk.END)
        self.custom_text.insert("1.0", out)

    def write_custom_params(self):
        txt = self.custom_text.get("1.0", tk.END).strip()
        extras = []
        for key, entry in self.custom_params.items():
            val = entry.get().strip()
            if val:
                extras.append(f"--{key}={val}")
        import re
        for key in self.custom_params:
            txt = re.sub(rf'--{re.escape(key)}=("[^"]*"|\S+)\s*', '', txt).strip()
        txt = (txt + " " + " ".join(extras)).strip()
        self.custom_text.delete("1.0", tk.END)
        self.custom_text.insert("1.0", txt)

    def send_custom(self):
        txt = self.custom_text.get("1.0", tk.END).strip()
        if not txt: return
        self.spell.delete("1.0", tk.END)
        self.spell.insert("1.0", txt)
        messagebox.showinfo("已发送", "已写入预设重建页。")

    def clear_custom(self):
        self.custom_algos.clear()
        self.custom_text.delete("1.0", tk.END)

    # ------------------------------------------------------- 子进程与日志 --
    def start_process(self, cmd: List[str]):
        if self.state.running:
            messagebox.showwarning("忙", "已有任务在运行。")
            return
        self.set_running(True)
        self.log_text.delete("1.0", tk.END)
        self.log("=" * 70)
        self.log("PyNX reconstruction")
        self.log(subprocess.list2cmdline(cmd))
        self.log("=" * 70)

        def worker():
            try:
                flags = subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0
                self.process = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, encoding="utf-8", errors="replace", bufsize=1,
                    creationflags=flags
                )
                assert self.process.stdout is not None
                for line in self.process.stdout:
                    self.log_queue.put(("line", line.rstrip("\n")))
                rc = self.process.wait()
                self.process = None
                self.log_queue.put(("done" if rc == 0 else "failed", f"任务结束，return code={rc}"))
            except Exception:
                self.log_queue.put(("line", traceback.format_exc()))
                self.log_queue.put(("failed", "任务启动失败"))
        threading.Thread(target=worker, daemon=True).start()

    def drain_log_queue(self):
        try:
            while True:
                kind, text = self.log_queue.get_nowait()
                if kind == "line":
                    self.log(text)
                elif kind == "done_pack":
                    self.log(f"CXI 文件生成成功：{text}")
                    self.set_running(False)
                    self.state.last_cxi = Path(text)
                    if messagebox.askyesno("完成", "是否把该 CXI 送到重建页？"):
                        self.recon_cxi.set(text)
                elif kind == "done":
                    self.log(text)
                    self.set_running(False)
                elif kind == "failed":
                    self.log(text)
                    self.set_running(False)
        except queue.Empty:
            pass
        self.root.after(80, self.drain_log_queue)

    def stop_task(self):
        if not self.process or self.process.poll() is not None:
            return
        if messagebox.askyesno("停止", "确定终止当前任务？"):
            self.process.terminate()
            self.log("已发送 terminate")

    def set_running(self, running):
        self.state.running = running
        self.stop_btn.configure(state=tk.NORMAL if running else tk.DISABLED)
        self.status.set("运行中..." if running else "就绪")

    def log(self, text):
        self.log_text.insert(tk.END, str(text) + "\n")
        self.log_text.see(tk.END)

    # ------------------------------------------------------------- 结果查看 --
    def open_visualizer(self):
        f = filedialog.askopenfilename(filetypes=[("CXI/HDF5", "*.cxi *.h5 *.hdf5"), ("All", "*.*")])
        if not f: return
        try:
            import h5py
            import matplotlib.pyplot as plt
            with h5py.File(f, "r") as h:
                candidates = ["/entry_1/result_1/Object-layer00", "/entry_1/result_1/object"]
                path = next((p for p in candidates if p in h), None)
                if path is None:
                    raise KeyError("没有找到常见 Object 数据集")
                obj = np.asarray(h[path][()]).squeeze()
            if obj.ndim != 2:
                raise ValueError(f"Object shape={obj.shape}，不是二维")
            fig, ax = plt.subplots(1, 2, figsize=(12, 5))
            ax[0].imshow(np.angle(obj), cmap="gray"); ax[0].set_title("Object phase"); ax[0].axis("off")
            ax[1].imshow(np.abs(obj), cmap="gray"); ax[1].set_title("Object amplitude"); ax[1].axis("off")
            plt.tight_layout(); plt.show()
        except Exception as e:
            messagebox.showerror("查看失败", f"{type(e).__name__}: {e}")

    def open_output_dir(self):
        p = Path(self.save_prefix.get().strip()).parent if self.save_prefix.get().strip() else SCRIPT_DIR
        if not p.exists():
            messagebox.showerror("目录不存在", str(p)); return
        if os.name == "nt": os.startfile(str(p))
        else: subprocess.Popen(["xdg-open", str(p)])

    def on_close(self):
        if self.state.running and not messagebox.askyesno("退出", "当前仍有任务运行，确定退出？"):
            return
        self.root.destroy()


