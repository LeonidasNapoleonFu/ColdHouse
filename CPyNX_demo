class FlatButton(tk.Button):
    def __init__(self, master, bg, hover, **kwargs):
        super().__init__(master, **kwargs)
        self._bg0, self._bgh = bg, hover
        self.configure(
            bg=bg, fg="white", bd=0, padx=14, pady=7,
            font=("微软雅黑", 10, "bold"), cursor="hand2",
            relief=tk.FLAT, activebackground=hover, activeforeground="white"
        )
        self.bind("<Enter>", lambda _: self.configure(bg=self._bgh) if self["state"] != tk.DISABLED else None)
        self.bind("<Leave>", lambda _: self.configure(bg=self._bg0))


