def ensure_pynx_env() -> None:
    try:
        import pynxsimu  # noqa: F401
        return
    except ImportError:
        pass

    if PYNX_PYTHON.exists() and Path(sys.executable).resolve() != PYNX_PYTHON.resolve():
        os.execv(str(PYNX_PYTHON), [str(PYNX_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])

    raise RuntimeError(
        "未检测到 PyNX，\n"
        "请先确认 PyNX 环境路径。"
    )


