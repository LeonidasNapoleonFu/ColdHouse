np.save(os.path.join(SAVE_DIR,"probe_epie.npy"),probe_epie_scaled)

print("="*70)
print("Starting algorithm schedule")
print("="*70)

history=[]

for step,(algo,cycles,update_obj,update_probe,update_pos) in enumerate(ALGORITHM_SCHEDULE):

    print("="*70)
    print(
        f"Step {step+1}/{len(ALGORITHM_SCHEDULE)} : "
        f"{algo} cycles={cycles} "
        f"O={update_obj} P={update_probe} POS={update_pos}"
    )
    print("="*70)


    if algo=="DM":

        p=DM(
            update_object=update_obj,
            update_probe=update_probe,
            update_background=False,
            nb_cycle=cycles,
            calc_llk=20,
            show_obj_probe=False,

            obj_smooth_sigma=0,
            obj_inertia=0.05,

            probe_smooth_sigma=0.2,
            probe_inertia=0.02,

            update_pos=False,

            zero_phase_ramp=True,
            alpha=0.02

        )*p



    elif algo=="AP":

        p=AP(
            update_object=update_obj,
            update_probe=update_probe,
            update_background=False,

            nb_cycle=cycles,
            calc_llk=20,

            show_obj_probe=False,

            obj_smooth_sigma=0,
            obj_inertia=0.05,

            probe_smooth_sigma=0.2,
            probe_inertia=0.02,

            update_pos=update_pos,

            zero_phase_ramp=True

        )*p



    elif algo=="ML":

        p=ML(
            update_object=update_obj,
            update_probe=update_probe,

            update_background=False,

            nb_cycle=cycles,
            calc_llk=20,

            show_obj_probe=False,

            update_pos=False

        )*p



    else:

        raise ValueError(
            f"Unknown algorithm: {algo}"
        )


    llk=p.get_llk('poisson')

    print(
        f"{algo} finished Poisson LLK:",
        llk
    )


    history.append(
        [
            step+1,
            algo,
            cycles,
            update_obj,
            update_probe,
            update_pos,
            llk
        ]
    )


    np.save(
        os.path.join(
            SAVE_DIR,
            f"object_step{step+1}_{algo}.npy"
        ),
        p.get_obj()
    )


    np.save(
        os.path.join(
            SAVE_DIR,
            f"probe_step{step+1}_{algo}.npy"
        ),
        p.get_probe()
    )
    llk=p.get_llk('poisson')
    print(f"{algo} finished Poisson LLK:",llk)
    history.append([step+1,algo,cycles,update_obj,update_probe,update_pos,llk])
    np.save(os.path.join(SAVE_DIR,f"object_step{step+1}_{algo}.npy"),p.get_obj())
    np.save(os.path.join(SAVE_DIR,f"probe_step{step+1}_{algo}.npy"),p.get_probe())

