# ===== expand probe to multimode =====
NB_PROBE=NB
MODE_SEED=0.03

pr=np.asarray(p.get_probe(),dtype=np.complex64)
pr0=pr[0].copy()
ny,nx=pr0.shape
rng=np.random.default_rng(1234)

pr_multi=np.zeros((NB_PROBE,ny,nx),dtype=np.complex64)
pr_multi[0]=pr0

amp_rms=np.sqrt(np.mean(np.abs(pr0)**2))
for m in range(1,NB_PROBE):
    noise=(rng.standard_normal((ny,nx))+1j*rng.standard_normal((ny,nx)))/np.sqrt(2)
    pr_multi[m]=MODE_SEED*amp_rms*noise

# preserve total probe power
power0=np.sum(np.abs(pr0)**2)
power_multi=np.sum(np.abs(pr_multi)**2)
pr_multi*=np.sqrt(power0/(power_multi+1e-30))

p.set_probe(pr_multi)
p=ScaleObjProbe(verbose=True)*p

print("Probe modes:",p.get_nb_probe())
print("Probe shape:",p.get_probe().shape)
for m in range(NB_PROBE):
    pm=np.sum(np.abs(p.get_probe()[m])**2)
    print(f"Mode {m} power fraction:",pm/np.sum(np.abs(p.get_probe())**2))

obj_epie_scaled=np.squeeze(p.get_obj()).astype(np.complex64).copy()
probe_epie_scaled=np.squeeze(p.get_probe()).astype(np.complex64).copy()
